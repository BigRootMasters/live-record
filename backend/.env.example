# 系统配置
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

# Docker 构建镜像源配置（适合中国大陆服务器）
DOCKER_APT_MIRROR=https://mirrors.aliyun.com/debian
DOCKER_APT_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security
DOCKER_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
DOCKER_PIP_EXTRA_INDEX_URL=
DOCKER_PIP_TRUSTED_HOST=mirrors.aliyun.com

# 数据库配置
DATABASE_URL=sqlite:///./data.db
BACKUP_INTERVAL=86400

# 存储配置
VIDEO_STORAGE_PATH=./data/recordings
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
RECORDING_MODE=video
AUDIO_RECORDING_BITRATE=64k
AUDIO_RECORDING_SAMPLE_RATE=16000
AUDIO_RECORDING_CHANNELS=1

# 抖音配置
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36
USE_REAL_API=True
API_TIMEOUT=10
API_RETRIES=3

# 企业微信配置
WECHAT_WEBHOOK_URL=
WECHAT_TIMEOUT=10
WECHAT_RETRIES=3
AUTO_SEND_AUDIO_ON_RECORDING_COMPLETE=True
WECHAT_AUDIO_BITRATE=16k
WECHAT_AUDIO_SAMPLE_RATE=16000
WECHAT_AUDIO_CHANNELS=1
WECHAT_AUDIO_MAX_MB=20

# 主播配置
ANCHOR_CONFIG_PATH=./config/anchors.json

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 定时任务配置
CHECK_INTERVAL=120
OFFLINE_CONFIRMATION_CHECKS=2
KEEP_RECORDING_ON_DISCOVERY_ERROR=True
MAX_RECORDING_DURATION=9000
RECORDING_RETENTION_DAYS=7
RECORDING_QUALITY=720p
