# 系统配置
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=your_secret_key_here

# 数据库配置
DATABASE_URL=sqlite:///./data.db
BACKUP_INTERVAL=86400  # 数据库备份间隔（秒）

# 存储配置
VIDEO_STORAGE_PATH=./data/recordings  # 录制媒体存储根目录
RECORDING_MODE=audio  # video | audio，仅录音频时保存 mp3
AUDIO_RECORDING_BITRATE=64k
AUDIO_RECORDING_SAMPLE_RATE=16000
AUDIO_RECORDING_CHANNELS=1

# 抖音配置
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36
USE_REAL_API=True  # 是否使用真实API
API_TIMEOUT=10  # API请求超时时间（秒）
API_RETRIES=3  # API请求重试次数

# 企业微信配置
WECHAT_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=f94fbb88-9557-46f3-9c61-057b892fad9b
WECHAT_TIMEOUT=10  # 企业微信请求超时时间（秒）
WECHAT_RETRIES=3  # 企业微信请求重试次数
AUTO_SEND_AUDIO_ON_RECORDING_COMPLETE=True  # 录制结束后自动发送音频到企业微信

# 主播配置
ANCHOR_CONFIG_PATH=./config/anchors.json

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 定时任务配置
CHECK_INTERVAL=120  # 检查主播是否开播的间隔（秒）
OFFLINE_CONFIRMATION_CHECKS=2  # 连续确认下播后再停止录制
KEEP_RECORDING_ON_DISCOVERY_ERROR=True  # 抖音页面偶发超时时不中断当前录制
MAX_RECORDING_DURATION=9000  # 录制上限（秒）
RECORDING_QUALITY=720p  # 录制质量
