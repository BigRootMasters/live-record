# 系统配置
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret

# 数据库配置
DATABASE_URL=sqlite:///./data.db
BACKUP_INTERVAL=86400

# 存储配置
VIDEO_STORAGE_PATH=./data/temp_videos
SUMMARY_STORAGE_PATH=./data/summaries

# 抖音配置
DOUYIN_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36
USE_REAL_API=True
API_TIMEOUT=10
API_RETRIES=3

# 企业微信配置
WECHAT_WEBHOOK_URL=
WECHAT_TIMEOUT=10
WECHAT_RETRIES=3
TRANSCRIPT_BASE_URL=http://your-server-ip-or-domain/summaries

# Whisper 配置
WHISPER_MODEL_SIZE=base
WHISPER_PYTHON_BIN=./whisper-venv/bin/python
WHISPER_SCRIPT_PATH=./scripts/local_transcribe.py

# 转写配置
TRANSCRIPTION_PROVIDER=aliyun
TRANSCRIPTION_FALLBACK_PROVIDER=local
TRANSCRIPTION_LANGUAGE=zh
AUDIO_CHUNK_MINUTES=10
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AUTO_NOTIFY_ON_TRANSCRIBE=True

# 阿里云 Paraformer 配置
ALIYUN_DASHSCOPE_API_KEY=
ALIYUN_PARAFORMER_MODEL=paraformer-v2
ALIYUN_PARAFORMER_LANGUAGE_HINTS=zh
PUBLIC_BASE_URL=http://your-server-ip-or-domain

# 主播配置
ANCHOR_CONFIG_PATH=./config/anchors.json

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# 定时任务配置
CHECK_INTERVAL=120
MAX_RECORDING_DURATION=9000
RECORDING_QUALITY=720p
SUMMARY_SEND_TIME=08:00
